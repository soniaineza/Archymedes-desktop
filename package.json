{
  "name": "archymedes-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Archymedes Desktop — an IDE-style desktop client for the Archymedes coding agent.",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.archymedes.desktop",
    "productName": "Archymedes Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@types/three": "^0.185.4",
    "node-pty": "^1.0.0",
    "openai": "^4.104.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
